<Project Sdk="Microsoft.NET.Sdk">

  <!-- Framework-free RAG building blocks: extraction, chunking, retrieval, grounding and provider abstractions.
       No EF Core and no ASP.NET dependencies, so everything here is unit-testable in isolation. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClaimWise.Rag</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClaimWise.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.*" />
  </ItemGroup>

</Project>
