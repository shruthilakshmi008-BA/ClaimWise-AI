{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=claimwise.db"
  },
  "Seed": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "RateLimiting": {
    "PermitLimit": 30
  },
  "Ai": {
    "Embeddings": {
      "Provider": "Local",
      "LocalDimensions": 512,
      "OpenAiCompatible": {
        "BaseUrl": "",
        "Model": "",
        "Dimensions": 1536,
        "SendDimensions": false,
        "TimeoutSeconds": 60,
        "MaxRetries": 2
      }
    },
    "Llm": {
      "Provider": "Extractive",
      "OpenAiCompatible": {
        "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
        "Model": "gemini-3.6-flash",
        "TimeoutSeconds": 60,
        "MaxRetries": 2,
        "JsonMode": true
      },
      "Anthropic": {
        "Model": "claude-opus-5-5",
        "MaxOutputTokens": 4096,
        "TimeoutSeconds": 120,
        "MaxRetries": 2
      }
    },
    "Retrieval": {
      "KeywordTopK": 20,
      "VectorTopK": 20,
      "RerankCandidates": 15,
      "FinalTopK": 6
    },
    "Evidence": {
      "MinTopScore": 0.35,
      "SupportThreshold": 0.3,
      "MinSupportingPassages": 1,
      "MinCoverage": 0.5
    },
    "Uploads": {
      "MaxBytes": 10485760,
      "MaxChunksPerDocument": 2000
    }
  }
}
