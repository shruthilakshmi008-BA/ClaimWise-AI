# ClaimWise AI: configuration template.
# ASP.NET Core reads environment variables with "__" as the section separator, so Ai__Llm__Provider means
# the setting Ai:Llm:Provider in appsettings.json. Copy the lines you need into your shell, a launch profile, or
# `dotnet user-secrets` (preferred for keys). NEVER commit real keys: .env files are git-ignored.
# Defaults (no variables set): SQLite, local hashing embeddings, extractive summaries = fully offline, no keys needed.

# ---- Database ---------------------------------------------------------------------------------------------------
# Database__Provider=Sqlite                  # Sqlite (default) | PostgreSQL
# ConnectionStrings__Default=Data Source=claimwise.db
# PostgreSQL example:
# Database__Provider=PostgreSQL
# ConnectionStrings__Default=Host=localhost;Database=claimwise;Username=claimwise;Password=change-me
# Database__AutoMigrate=true                 # set false to run `dotnet ef database update` yourself

# ---- Demo data (Development only) --------------------------------------------------------------------------------
# Seed__Enabled=true                         # 8 synthetic claims (only when the Claims table is empty)
# Seed__PolicyDirectory=../../samples/policies   # ingests the 4 fictional sample policies (only when none exist)

# ---- Embeddings ---------------------------------------------------------------------------------------------------
# Ai__Embeddings__Provider=Local             # Local (offline hashing embedder) | OpenAiCompatible
# Ai__Embeddings__LocalDimensions=512
# Ai__Embeddings__OpenAiCompatible__BaseUrl=https://api.openai.com/v1      # or http://localhost:11434/v1 (Ollama) ...
# Ai__Embeddings__OpenAiCompatible__ApiKey=
# Ai__Embeddings__OpenAiCompatible__Model=text-embedding-3-small
# Ai__Embeddings__OpenAiCompatible__Dimensions=1536                        # must match the model's output size
# Ai__Embeddings__OpenAiCompatible__SendDimensions=false                   # true only for models that accept "dimensions"
# After changing the embedding provider/model run POST /api/policies/reindex (or the "Re-index all" button).

# ---- Summaries (the language model) ------------------------------------------------------------------------------
# Ai__Llm__Provider=Extractive               # Extractive (no model) | OpenAiCompatible | Anthropic
# Ai__Llm__OpenAiCompatible__BaseUrl=https://api.openai.com/v1
# Ai__Llm__OpenAiCompatible__ApiKey=
# Ai__Llm__OpenAiCompatible__Model=
# Ai__Llm__OpenAiCompatible__JsonMode=true   # set false for servers that reject response_format
# Ai__Llm__Anthropic__ApiKey=                # or leave empty and set ANTHROPIC_API_KEY
# Ai__Llm__Anthropic__Model=claude-opus-5-5
# Ai__Llm__Anthropic__TimeoutSeconds=120

# ---- Evidence thresholds (when to abstain) -----------------------------------------------------------------------
# Ai__Evidence__MinTopScore=0.35
# Ai__Evidence__SupportThreshold=0.30
# Ai__Evidence__MinCoverage=0.50

# ---- Limits -------------------------------------------------------------------------------------------------------
# Ai__Uploads__MaxBytes=10485760             # policy upload size cap
# ClaimFiles__Path=claim-files               # where uploaded claim documents are stored
# ClaimFiles__MaxBytes=10485760
# RateLimiting__PermitLimit=30               # requests/minute/client on upload + AI endpoints

# ---- CORS (only needed when the UI is NOT served through the Vite proxy) ------------------------------------------
# Cors__AllowedOrigins__0=http://localhost:5173
